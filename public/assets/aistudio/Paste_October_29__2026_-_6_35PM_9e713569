    <!-- ================= JAVASCRIPT: THREE.JS 3D ENGINE + INTERACTIONS ================= -->
    <script>
        // ------------------------------------------------------------------
        // 1. SPOTLIGHT MOUSE TRACKING FOR BENTO CARDS & CAUSTIC BACKGROUND
        // ------------------------------------------------------------------
        document.addEventListener('mousemove', (e) => {
            document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
            document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);

            document.querySelectorAll('.bento-card').forEach(card => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--card-x', `${x}px`);
                card.style.setProperty('--card-y', `${y}px`);
            });
        });

        // ------------------------------------------------------------------
        // 2. THREE.JS 3D DIGITAL TWIN: "ESCALERA AL CIELO"
        // ------------------------------------------------------------------
        let scene, camera, renderer;
        let carriageGroup, calisthenicsBarsGroup, waterMesh, bubblesSystem;
        let stepMeshes = [];
        let targetImmersion = 0; // 0 to 1
        let currentImmersion = 0;
        let targetCamAngle = { theta: 0.75, phi: 1.05, dist: 12.5 };
        let currentCamAngle = { theta: 0.75, phi: 1.05, dist: 12.5 };
        let isDragging = false;
        let prevMouse = { x: 0, y: 0 };
        let autoCycleInterval = null;

        function initThreeJS() {
            const container = document.getElementById('three-canvas-container');
            const width = container.clientWidth || 800;
            const height = container.clientHeight || 520;

            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x02070e, 0.035);

            camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 100);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            // Lights
            const ambientLight = new THREE.AmbientLight(0x88ccff, 0.75);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 1.1);
            dirLight.position.set(8, 14, 10);
            scene.add(dirLight);

            const aquaPointLight = new THREE.PointLight(0x00f2fe, 1.6, 18);
            aquaPointLight.position.set(2, -1, 2);
            scene.add(aquaPointLight);

            // Materials
            const deckMat = new THREE.MeshStandardMaterial({ color: 0x0f1f38, roughness: 0.6, metalness: 0.2 });
            const copingMat = new THREE.MeshStandardMaterial({ color: 0x1e3a5f, roughness: 0.4, metalness: 0.3 });
            const steelMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, roughness: 0.25, metalness: 0.85 });
            const neonCyanMat = new THREE.MeshStandardMaterial({ color: 0x00f2fe, emissive: 0x00f2fe, emissiveIntensity: 0.45, roughness: 0.2 });
            const neonGoldMat = new THREE.MeshStandardMaterial({ color: 0xfbbf24, emissive: 0xf59e0b, emissiveIntensity: 0.35, roughness: 0.2 });
            const seatMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.3, metalness: 0.1 });

            // 1. Pool Deck & Wall Structure (Left Side)
            const deckWall = new THREE.Mesh(new THREE.BoxGeometry(4.5, 5.2, 6.5), deckMat);
            deckWall.position.set(-4.25, -0.4, 0);
            scene.add(deckWall);

            // Pool Coping Edge
            const copingEdge = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.25, 6.6), copingMat);
            copingEdge.position.set(-2.15, 2.25, 0);
            scene.add(copingEdge);

            // Pool Floor Grid
            const gridHelper = new THREE.GridHelper(11, 22, 0x00f2fe, 0x0e294b);
            gridHelper.position.set(2.2, -2.95, 0);
            scene.add(gridHelper);

            // 2. Diagonal Mechanical Guide Rails
            const railLength = 5.8;
            const railGeo = new THREE.CylinderGeometry(0.08, 0.08, railLength, 16);
            [-1.1, 1.1].forEach(zOffset => {
                const rail = new THREE.Mesh(railGeo, steelMat);
                rail.position.set(-0.2, 0.2, zOffset);
                rail.rotation.z = Math.PI / 4; // 45 degrees slope into pool
                scene.add(rail);
            });

            // 3. Articulating Automatic Stair Steps along the rail
            const stepGeo = new THREE.BoxGeometry(0.65, 0.08, 2.0);
            for (let i = 0; i < 5; i++) {
                const step = new THREE.Mesh(stepGeo, copingMat);
                const t = (i + 1) / 6;
                step.position.set(-1.9 + t * 3.4, 2.0 - t * 3.4, 0);
                scene.add(step);
                stepMeshes.push(step);
            }

            // 4. Moving Submersible Carriage Group (Platform + Chair + Calisthenics Bars)
            carriageGroup = new THREE.Group();

            // Submersible Platform Base
            const platformBase = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.16, 2.3), neonCyanMat);
            carriageGroup.add(platformBase);

            // Ergonomic Chair Seat & Backrest
            const chairSeat = new THREE.Mesh(new THREE.BoxGeometry(0.95, 0.14, 0.95), seatMat);
            chairSeat.position.set(-0.2, 0.55, 0);
            carriageGroup.add(chairSeat);

            const chairColumn = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.16, 0.45, 16), steelMat);
            chairColumn.position.set(-0.2, 0.28, 0);
            carriageGroup.add(chairColumn);

            const chairBack = new THREE.Mesh(new THREE.BoxGeometry(0.14, 1.15, 0.92), seatMat);
            chairBack.position.set(-0.62, 1.15, 0);
            chairBack.rotation.z = 0.12;
            carriageGroup.add(chairBack);

            const headrest = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.28, 0.55), neonCyanMat);
            headrest.position.set(-0.7, 1.82, 0);
            carriageGroup.add(headrest);

            // Safety Armrests
            [-0.52, 0.52].forEach(zPos => {
                const arm = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.08, 0.1), neonCyanMat);
                arm.position.set(-0.2, 0.88, zPos);
                carriageGroup.add(arm);
            });

            // 5. Deployable Aquatic Calisthenics Bars Module (Parallel Bars + Overhead Pull Bar)
            calisthenicsBarsGroup = new THREE.Group();
            [-0.75, 0.75].forEach(zPos => {
                // Parallel Dip Bar
                const hBar = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 1.5, 16), neonGoldMat);
                hBar.rotation.z = Math.PI / 2;
                hBar.position.set(0.45, 1.05, zPos);
                calisthenicsBarsGroup.add(hBar);

                // Vertical Support Post
                const vPost = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.045, 1.05, 16), steelMat);
                vPost.position.set(1.0, 0.52, zPos);
                calisthenicsBarsGroup.add(vPost);
            });

            // Overhead Suspension / Pull-up Frame
            const topCrossBar = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 1.6, 16), neonGoldMat);
            topCrossBar.rotation.x = Math.PI / 2;
            topCrossBar.position.set(0.75, 2.25, 0);
            calisthenicsBarsGroup.add(topCrossBar);

            [-0.75, 0.75].forEach(zPos => {
                const tallPost = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 1.2, 16), steelMat);
                tallPost.position.set(0.75, 1.65, zPos);
                calisthenicsBarsGroup.add(tallPost);
            });

            carriageGroup.add(calisthenicsBarsGroup);
            scene.add(carriageGroup);

            // 6. Translucent Animated Water Volume
            const waterGeo = new THREE.BoxGeometry(7.8, 3.9, 6.5, 24, 1, 24);
            const waterMat = new THREE.MeshPhysicalMaterial({
                color: 0x00c6ff,
                transparent: true,
                opacity: 0.38,
                roughness: 0.15,
                metalness: 0.1,
                transmission: 0.5
            });
            waterMesh = new THREE.Mesh(waterGeo, waterMat);
            waterMesh.position.set(1.9, -1.0, 0);
            scene.add(waterMesh);

            // 7. Rising Hydrotherapy Bubbles Particle System
            const bubbleCount = 80;
            const bubbleGeo = new THREE.BufferGeometry();
            const positions = new Float32Array(bubbleCount * 3);
            for (let i = 0; i < bubbleCount; i++) {
                positions[i * 3] = -1.5 + Math.random() * 6.5;
                positions[i * 3 + 1] = -2.8 + Math.random() * 3.6;
                positions[i * 3 + 2] = -2.8 + Math.random() * 5.6;
            }
            bubbleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const bubbleMat = new THREE.PointsMaterial({ color: 0x00f2fe, size: 0.12, transparent: true, opacity: 0.7 });
            bubblesSystem = new THREE.Points(bubbleGeo, bubbleMat);
            scene.add(bubblesSystem);

            // Mouse & Touch Orbit Controls
            const domElem = renderer.domElement;
            domElem.addEventListener('mousedown', (e) => { isDragging = true; prevMouse = { x: e.clientX, y: e.clientY }; });
            window.addEventListener('mouseup', () => { isDragging = false; });
            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                const dx = e.clientX - prevMouse.x;
                const dy = e.clientY - prevMouse.y;
                targetCamAngle.theta -= dx * 0.008;
                targetCamAngle.phi = Math.max(0.4, Math.min(1.45, targetCamAngle.phi - dy * 0.006));
                prevMouse = { x: e.clientX, y: e.clientY };
            });

            // Touch Support
            domElem.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) {
                    isDragging = true;
                    prevMouse = { x: e.touches[0].clientX, y: e.touches[0].clientY };
                }
            }, { passive: true });
            window.addEventListener('touchend', () => { isDragging = false; });
            window.addEventListener('touchmove', (e) => {
                if (!isDragging || e.touches.length !== 1) return;
                const dx = e.touches[0].clientX - prevMouse.x;
                const dy = e.touches[0].clientY - prevMouse.y;
                targetCamAngle.theta -= dx * 0.008;
                targetCamAngle.phi = Math.max(0.4, Math.min(1.45, targetCamAngle.phi - dy * 0.006));
                prevMouse = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            }, { passive: true });

            window.addEventListener('resize', onWindowResize);
            animateThreeJS();
        }

        function onWindowResize() {
            const container = document.getElementById('three-canvas-container');
            if (!container || !renderer) return;
            const w = container.clientWidth;
            const h = container.clientHeight;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
        }

        function setCameraAngle(preset) {
            if (preset === 'iso') targetCamAngle = { theta: 0.75, phi: 1.05, dist: 12.5 };
            if (preset === 'side') targetCamAngle = { theta: 0.0, phi: 1.32, dist: 11.8 };
            if (preset === 'front') targetCamAngle = { theta: 1.52, phi: 1.18, dist: 11.2 };
        }

        function animateThreeJS() {
            requestAnimationFrame(animateThreeJS);

            // Smooth damping for immersion position
            currentImmersion += (targetImmersion - currentImmersion) * 0.08;

            // Move carriage along diagonal path from (-2.1, 2.2) to (1.6, -1.5)
            if (carriageGroup) {
                const xPos = -2.1 + currentImmersion * 3.7;
                const yPos = 2.2 - currentImmersion * 3.7;
                carriageGroup.position.set(xPos, yPos, 0);

                // Deploy Calisthenics bars smoothly as depth increases past 40%
                const barDeploy = Math.max(0.01, Math.min(1, (currentImmersion - 0.3) * 1.4));
                calisthenicsBarsGroup.scale.set(barDeploy, barDeploy, 1);
            }

            // Animate Articulating Steps
            stepMeshes.forEach((step, idx) => {
                step.rotation.z = (1 - currentImmersion) * 0.35;
            });

            // Animate Rising Bubbles
            if (bubblesSystem) {
                const posArr = bubblesSystem.geometry.attributes.position.array;
                for (let i = 0; i < posArr.length; i += 3) {
                    posArr[i + 1] += 0.018;
                    if (posArr[i + 1] > 0.85) posArr[i + 1] = -2.8;
                }
                bubblesSystem.geometry.attributes.position.needsUpdate = true;
            }

            // Smooth Camera Orbit Interpolation
            currentCamAngle.theta += (targetCamAngle.theta - currentCamAngle.theta) * 0.08;
            currentCamAngle.phi += (targetCamAngle.phi - currentCamAngle.phi) * 0.08;
            currentCamAngle.dist += (targetCamAngle.dist - currentCamAngle.dist) * 0.08;

            camera.position.x = currentCamAngle.dist * Math.sin(currentCamAngle.phi) * Math.sin(currentCamAngle.theta);
            camera.position.y = currentCamAngle.dist * Math.cos(currentCamAngle.phi);
            camera.position.z = currentCamAngle.dist * Math.sin(currentCamAngle.phi) * Math.cos(currentCamAngle.theta);
            camera.lookAt(0, 0, 0);

            renderer.render(scene, camera);
        }

        // ------------------------------------------------------------------
        // 3. UI CONTROLS FOR THE 3D SIMULATOR
        // ------------------------------------------------------------------
        function update3DSimulation(val) {
            const pct = parseInt(val, 10);
            document.getElementById('slider-3d').value = pct;
            document.getElementById('slider-pct-display').textContent = `${pct}%`;

            targetImmersion = pct / 100;

            // Telemetry Calculations
            const depth = ((pct / 100) * 1.20).toFixed(2);
            const buoyancy = Math.min(85, Math.round(pct * 0.85));

            document.getElementById('hud-depth-val').textContent = `${depth} m`;
            document.getElementById('hud-buoyancy-val').textContent = `${buoyancy}%`;
            document.getElementById('hud-steps-val').textContent = pct < 20 ? 'En Borde (0°)' : pct < 80 ? 'Articulando' : 'Escalonados';

            // Update Phase Buttons & Descriptions
            const b1 = document.getElementById('btn-phase-1');
            const b2 = document.getElementById('btn-phase-2');
            const b3 = document.getElementById('btn-phase-3');
            [b1, b2, b3].forEach(b => {
                b.className = 'p-3 rounded-2xl border border-white/10 bg-white/[0.02] text-left hover:border-white/30 transition';
            });

            const badge = document.getElementById('hud-phase-badge');
            const title = document.getElementById('panel-stage-title');
            const desc = document.getElementById('panel-stage-desc');
            const stairsLegend = document.getElementById('legend-stairs-state');
            const barsLegend = document.getElementById('legend-bars-state');

            if (pct < 25) {
                b1.className = 'p-3 rounded-2xl border border-biocian bg-biocian/15 text-left transition';
                badge.textContent = 'FASE 01 // EMBARQUE EN BORDE SECO';
                title.textContent = '1. Transferencia Segura y Autónoma';
                desc.textContent = 'La plataforma se nivela a ras del borde de la pileta. La silla postural permanece anclada magnéticamente para que el usuario ingrese sin escalones ni esfuerzo físico.';
                stairsLegend.textContent = 'Anclada en Borde';
                barsLegend.textContent = 'Replegadas';
            } else if (pct < 80) {
                b2.className = 'p-3 rounded-2xl border border-biocian bg-biocian/15 text-left transition';
                badge.textContent = 'FASE 02 // INMERSIÓN AUTOMATIZADA';
                title.textContent = '2. Descenso Hidromecánico Progresivo';
                desc.textContent = 'Los peldaños se articulan automáticamente mientras la plataforma desciende de forma suave y controlada, permitiendo que el cuerpo se adapte a la flotabilidad sin impacto.';
                stairsLegend.textContent = 'En Transición';
                barsLegend.textContent = 'Desplegando...';
            } else {
                b3.className = 'p-3 rounded-2xl border border-biocian bg-biocian/15 text-left transition';
                badge.textContent = 'FASE 03 // ESTACIÓN DE CALISTENIA ACUÁTICA';
                title.textContent = '3. Hidrocinesiterapia y Fuerza Adaptada';
                desc.textContent = 'A 1.20m de profundidad, las barras paralelas y el pórtico superior quedan activos. El agua alivia el 85% del peso corporal, permitiendo ejercitar con libertad y dignidad.';
                stairsLegend.textContent = 'Sumergida Fija';
                barsLegend.textContent = '100% Activas';
            }
        }

        function stopAutoCycle3D() {
            if (autoCycleInterval) {
                clearInterval(autoCycleInterval);
                autoCycleInterval = null;
                document.getElementById('btn-autocycle-3d').innerHTML = '<i class="fa-solid fa-arrows-spin"></i><span>Simulación Automática</span>';
            }
        }

        function toggleAutoCycle3D() {
            if (autoCycleInterval) {
                stopAutoCycle3D();
                return;
            }
            document.getElementById('btn-autocycle-3d').innerHTML = '<i class="fa-solid fa-pause"></i><span>Detener Ciclo</span>';
            let dir = 1;
            let val = parseInt(document.getElementById('slider-3d').value, 10);
            autoCycleInterval = setInterval(() => {
                val += dir * 2;
                if (val >= 100) { val = 100; dir = -1; }
                if (val <= 0) { val = 0; dir = 1; }
                update3DSimulation(val);
            }, 55);
        }

        // ------------------------------------------------------------------
        // 4. BISOCIACIÓN CREATIVA INTERACTION
        // ------------------------------------------------------------------
        const bisoContent = {
            1: {
                tag: 'MARCO MENTAL 01 // CALISTENIA ADAPTADA',
                title: 'Barras y Fuerza Corporal llevadas al Agua',
                desc: 'Tomamos la filosofía de la calistenia —dominar el propio cuerpo mediante barras paralelas y tracciones— y eliminamos la barrera de la gravedad extrema sumergiendo la estación.'
            },
            2: {
                tag: 'MARCO MENTAL 02 // HIDROCINESITERAPIA («PONYO»)',
