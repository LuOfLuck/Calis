                    </div>
                </div>
            `).join('');
        }

        // ------------------------------------------------------------------
        // 6. MODO DIRECTOR DE VIDEO PITCH DE 30 SEGUNDOS (AUTO-GUIADO)
        // ------------------------------------------------------------------
        let pitchTimer = null;
        let pitchSec = 0;

        const pitchTimeline = [
            {
                start: 0, end: 7,
                scene: 'ESCENA 1/4 // EL PROBLEMA REAL (00:00 - 00:07)',
                script: '"La hidroterapia sana, pero para muchas personas con desafíos motrices, entrar al agua es una barrera imposible."',
                action: () => {
                    document.getElementById('gemelo-3d').scrollIntoView({ behavior: 'smooth' });
                    setCameraAngle('side');
                    update3DSimulation(0);
                }
            },
            {
                start: 7, end: 15,
                scene: 'ESCENA 2/4 // LA BISOCIACIÓN CREATIVA (00:07 - 00:15)',
                script: '"En CALISPONYO unimos la calistenia con la tecnología asistiva para crear inclusión en movimiento."',
                action: () => {
                    setCameraAngle('iso');
                    update3DSimulation(45);
                }
            },
            {
                start: 15, end: 23,
                scene: 'ESCENA 3/4 // PRODUCTO ESTRELLA: ESCALERA AL CIELO (00:15 - 00:23)',
                script: '"Presentamos «Escalera al Cielo»: una plataforma con silla sumergible y escalera automática que devuelve la autonomía."',
                action: () => {
                    setCameraAngle('front');
                    update3DSimulation(100);
                }
            },
            {
                start: 23, end: 30,
                scene: 'ESCENA 4/4 // CIERRE & IMPACTO (00:23 - 00:30)',
                script: '"CALISPONYO: tecnología que emerge con vos. Presentado por Grupo Tres Generaciones."',
                action: () => {
                    setCameraAngle('iso');
                }
            }
        ];

        function startCinematicPitch() {
            stopAutoCycle3D();
            if (pitchTimer) clearInterval(pitchTimer);
            pitchSec = 0;

            const hud = document.getElementById('cinematic-pitch-hud');
            hud.classList.remove('hidden');

            runPitchSecond();
            pitchTimer = setInterval(() => {
                pitchSec++;
                if (pitchSec > 30) {
                    clearInterval(pitchTimer);
                    pitchTimer = null;
                    return;
                }
                runPitchSecond();
            }, 1000);
        }

        function runPitchSecond() {
            const pct = (pitchSec / 30) * 100;
            document.getElementById('pitch-hud-bar').style.width = `${pct}%`;
            document.getElementById('pitch-hud-timer').textContent = `00:${String(pitchSec).padStart(2, '0')} / 00:30`;

            const currentStage = pitchTimeline.find(s => pitchSec >= s.start && pitchSec < s.end) || pitchTimeline[3];
            document.getElementById('pitch-hud-scene').textContent = currentStage.scene;
            document.getElementById('pitch-hud-script').textContent = currentStage.script;

            // Trigger 3D camera & immersion choreography at the start of each scene
            pitchTimeline.forEach(s => {
                if (pitchSec === s.start) s.action();
            });
        }

        function stopCinematicPitch() {
            if (pitchTimer) clearInterval(pitchTimer);
            pitchTimer = null;
            document.getElementById('cinematic-pitch-hud').classList.add('hidden');
        }

        // Initialize everything on load
        window.onload = function () {
            initThreeJS();
            update3DSimulation(0);
            renderWorkoutProtocol('neuro');
        };
    </script>
