            document.getElementById('biso-output-title').textContent = 'CALISPONYO: Tecnología que Emerge con Vos';
            document.getElementById('biso-output-desc').textContent = 'La unión perfecta entre Calistenia + Agua + Mecatrónica Asistiva. Un ecosistema que devuelve la autonomía y abre las puertas del deporte acuático a todas las capacidades motrices.';
        }

        // ------------------------------------------------------------------
        // 5. CATÁLOGO DE PROTOCOLOS DE CALISTENIA ACUÁTICA
        // ------------------------------------------------------------------
        const protocolsData = {
