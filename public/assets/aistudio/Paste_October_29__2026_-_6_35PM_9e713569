                            <span class="font-mono text-xs text-biocian-mint">${item.metric}</span>
                        </div>
                        <h3 class="font-display font-bold text-xl text-white">${item.title}</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">${item.desc}</p>
                    </div>
                    <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
                        <span>Adaptado a «Escalera al Cielo»</span>
