        function renderWorkoutProtocol(key) {
            ['neuro', 'movilidad', 'avanzado'].forEach(k => {
                const btn = document.getElementById(`proto-btn-${k}`);
                if (k === key) {
                    btn.className = 'px-4 py-2.5 rounded-xl bg-biocian text-abyss-950 font-display font-bold text-xs uppercase tracking-wider transition';
                } else {
                    btn.className = 'px-4 py-2.5 rounded-xl bento-card text-slate-300 hover:text-white font-display font-bold text-xs uppercase tracking-wider transition';
                }
            });

            const grid = document.getElementById('protocol-cards-grid');
            grid.innerHTML = protocolsData[key].map(item => `
                <div class="bento-card rounded-3xl p-7 flex flex-col justify-between space-y-5">
