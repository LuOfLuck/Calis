                radial-gradient(600px circle at 85% 15%, rgba(79, 172, 254, 0.12), transparent 50%),
                radial-gradient(700px circle at 10% 85%, rgba(0, 255, 170, 0.07), transparent 55%),
                #02070e;
        }

        /* Subtle Noise Overlay for Premium Film Grain */
        .noise-overlay {
            background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 0);
            background-size: 24px 24px;
        }

        /* Futuristic Bento Card with Mouse Spotlight */
        .bento-card {
            position: relative;
            background: rgba(5, 16, 32, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
            overflow: hidden;
        }

        .bento-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(500px circle at var(--card-x, 50%) var(--card-y, 50%), rgba(0, 242, 254, 0.14), transparent 40%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .bento-card:hover::before {
            opacity: 1;
        }

        .bento-card:hover {
            border-color: rgba(0, 242, 254, 0.35);
            box-shadow: 0 20px 50px -15px rgba(0, 242, 254, 0.15);
        }

        /* Neon Text Gradients */
        .text-liquid-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #00f2fe 55%, #00ffaa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Infinite Marquee */
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee {
            display: flex;
            width: max-content;
            animation: marquee 32s linear infinite;
        }
        .animate-marquee:hover {
            animation-play-state: paused;
        }

        /* Custom Futuristic Slider */
        input[type=range].hud-slider {
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            cursor: pointer;
        }
        input[type=range].hud-slider::-webkit-slider-runnable-track {
            height: 10px;
            border-radius: 999px;
            background: linear-gradient(90deg, #0a1e38 0%, #00f2fe 60%, #00ffaa 100%);
            border: 1px solid rgba(0, 242, 254, 0.4);
        }
        input[type=range].hud-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            margin-top: -8px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #02070e;
            border: 3px solid #00f2fe;
            box-shadow: 0 0 20px #00f2fe;
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        input[type=range].hud-slider::-webkit-slider-thumb:hover {
            transform: scale(1.2);
            background: #00f2fe;
        }

        /* Pulse Ring */
        @keyframes pulseRing {
            0% { transform: scale(0.9); opacity: 0.8; }
            70% { transform: scale(1.5); opacity: 0; }
            100% { transform: scale(1.5); opacity: 0; }
        }
        .pulse-ring::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 9999px;
            border: 2px solid #00f2fe;
            animation: pulseRing 2s infinite;
        }

        /* Three.js Canvas Container */
        #three-canvas-container canvas {
            width: 100% !important;
            height: 100% !important;
            display: block;
            outline: none;
        }
    </style>
